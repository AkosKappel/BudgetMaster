# Production settings for deploy/compose.yaml. Copy to .env in the deploy folder, chmod 600.
COMPOSE_FILE=compose.yaml:compose.tailscale.yaml

# The image to run: a commit tag from GHCR (sha-1234567), changed on every deploy.
IMAGE_TAG=sha-0000000

# Generate each with: openssl rand -base64 32
DB_PASSWORD=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://budgetmaster.tailb52c43.ts.net

# Password reset and email confirmation (resend.com, API keys). The sender must be on a
# domain verified in Resend; onboarding@resend.dev only delivers to the Resend account owner.
RESEND_API_KEY=
EMAIL_FROM=BudgetMaster <onboarding@resend.dev>

# Local access on the server (infra/hosting/ports.md), through nginx
APP_PORT=8085
# nginx's access log for the traffic dashboard and CrowdSec (absolute path)
ACCESS_LOG_DIR=/home/akap/logs/budgetmaster

# Nightly database dumps (14 days kept); copy this folder off the machine regularly.
BACKUP_DIR=/home/akap/backups/budgetmaster

# Optional Google sign-in; the redirect URL is <BETTER_AUTH_URL>/api/auth/callback/google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional GitHub sign-in; the callback URL is <BETTER_AUTH_URL>/api/auth/callback/github.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional Apple sign-in: Services ID as the client id, return URL
# <BETTER_AUTH_URL>/api/auth/callback/apple. The secret is a JWT signed with the Sign in with
# Apple key, valid for at most 6 months.
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
# Optional Microsoft sign-in (Entra app registration, personal and work accounts). Redirect URI:
# <BETTER_AUTH_URL>/api/auth/callback/microsoft.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Optional AI features (reading receipt photos with Claude); users opt in under Settings.
ANTHROPIC_API_KEY=
