# Database container (compose.yaml)
DB_PASSWORD=change-me
DB_HOST_PORT=5436

# App
DATABASE_URL=postgres://budgetmaster:change-me@127.0.0.1:5436/budgetmaster
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Optional email (resend.com). Without a key, emails are printed in the dev server output.
RESEND_API_KEY=
# EMAIL_FROM=BudgetMaster <noreply@your-verified-domain>

# Optional Google sign-in (Google Cloud console, OAuth client, web application). Redirect URL:
# <BETTER_AUTH_URL>/api/auth/callback/google. Without both, the button is hidden.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional GitHub sign-in (OAuth app). Callback URL: <BETTER_AUTH_URL>/api/auth/callback/github.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional Apple sign-in: Services ID as the client id, return URL
# <BETTER_AUTH_URL>/api/auth/callback/apple. The secret is a JWT signed with the Sign in with
# Apple key, valid for at most 6 months.
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
# Optional Microsoft sign-in (Entra app registration, personal and work accounts). Redirect URI:
# <BETTER_AUTH_URL>/api/auth/callback/microsoft.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Optional AI features (reading receipt photos with Claude); users opt in under Settings.
ANTHROPIC_API_KEY=
